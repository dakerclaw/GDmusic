# Google Drive 服务账号密钥（三选一）
# 1) 直接粘贴 JSON（注意去掉换行或转义引号）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# 2) Base64 编码的 JSON（推荐，避免换行问题）
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoi...

# 3) 密钥文件路径
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Google Drive 音乐文件夹 ID（支持多个，用逗号分隔）
DRIVE_FOLDER_ID=

# 是否递归扫描子文件夹（默认 true）
RECURSIVE=true

# 可选：访问口令（公开部署时建议启用）
# ACCESS_CODE=mypassword

# 可选：服务端口
PORT=9527
